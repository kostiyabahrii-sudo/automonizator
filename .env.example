# Дані застосунку Pinterest (developers.pinterest.com -> My apps)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Заповнюється автоматично скриптом oauth_setup.py після першої авторизації.
# Можна також вписати вручну, якщо refresh token вже є.
PINTEREST_REFRESH_TOKEN=

# ID дошки (board), куди публікувати піни. Знайти можна в URL дошки
# або через GET /v5/boards.
PINTEREST_BOARD_ID=
